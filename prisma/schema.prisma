generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  telefoni      String?
  adresa        String?
  nipt          String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  notifications Notification[]
  products      Product[]
  sales         Sale[]
  staff         Staff[]
  subscription  Subscription?
  suppliers     Supplier[]
  supplies      Supply[]
  userRoles     UserRole[]

  @@index([createdAt])
}

model Supplier {
  id             Int          @id @default(autoincrement())
  emri           String
  telefoni       String?
  email          String?
  adresa         String?
  shenime        String?
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  organization   Organization @relation(fields: [organizationId], references: [id])
  supplies       Supply[]

  @@index([organizationId, emri])
}

model Product {
  id             Int              @id @default(autoincrement())
  emri           String
  kategoria      String
  sasia          Float            @default(0)
  stokuMinimal   Float            @default(5)
  cmimiBlerjes   Float
  cmimiShitjes   Float
  njesia         String           @default("cope")
  isArchived     Boolean          @default(false)
  archivedAt     DateTime?
  furnitorId     Int?
  organizationId Int
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  furnitor       Supplier?        @relation(fields: [furnitorId], references: [id])
  organization   Organization     @relation(fields: [organizationId], references: [id])
  barcodes       ProductBarcode[]
  saleItems      SaleItem[]
  supplyItems    SupplyItem[]

  @@index([organizationId, isArchived])
  @@index([organizationId, emri])
  @@index([organizationId, kategoria])
  @@index([furnitorId])
}

model Supply {
  id             Int          @id @default(autoincrement())
  furnitorId     Int?
  organizationId Int
  data           DateTime     @default(now())
  shenime        String?
  totali         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  furnitor       Supplier?    @relation(fields: [furnitorId], references: [id])
  organization   Organization @relation(fields: [organizationId], references: [id])
  items          SupplyItem[]

  @@index([organizationId, createdAt])
  @@index([furnitorId])
}

model SupplyItem {
  id            Int     @id @default(autoincrement())
  supplyId      Int
  productId     Int
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  totali        Float
  product       Product @relation(fields: [productId], references: [id])
  supply        Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)

  @@index([supplyId])
  @@index([productId])
}

model ProductBarcode {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  productId Int
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Sale {
  id             Int          @id @default(autoincrement())
  totali         Float
  fitimi         Float
  shenime        String?
  paymentMethod  String       @default("cash")
  organizationId Int
  staffId        Int?
  staffName      String?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])
  staff          Staff?       @relation(fields: [staffId], references: [id])
  items          SaleItem[]

  @@index([organizationId, createdAt])
  @@index([organizationId, paymentMethod, createdAt])
  @@index([staffId])
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int
  productId     Int
  emriProduktit String
  sasia         Float
  cmimiBlerjes  Float
  cmimiShitjes  Float
  fitimi        Float
  product       Product @relation(fields: [productId], references: [id])
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)

  @@index([saleId])
  @@index([productId])
}

model UserRole {
  id             Int          @id @default(autoincrement())
  userId         String       @unique
  email          String
  roli           String       @default("staff")
  organizationId Int
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, email])
  @@index([email])
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         String
  userEmail      String
  userRole       String
  action         String
  entityType     String
  entityId       String?
  description    String
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, userId, createdAt])
  @@index([organizationId, action, createdAt])
  @@index([organizationId, entityType, createdAt])
}

model Notification {
  id             Int          @id @default(autoincrement())
  organizationId Int
  userId         String?
  type           String
  title          String
  message        String
  severity       String       @default("medium")
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
  organization   Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@index([organizationId, isRead])
  @@index([organizationId, userId, isRead])
  @@index([organizationId, type, isRead, createdAt])
}

model Subscription {
  id                 Int          @id @default(autoincrement())
  organizationId     Int          @unique
  plan               String       @default("trial")
  status             String       @default("trialing")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPlan           String?
  cancelAtPeriodEnd  Boolean      @default(false)
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt
  closeAtPeriodEnd   Boolean      @default(false)
  organization       Organization @relation(fields: [organizationId], references: [id])
}

model BillingAuditLog {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  changedByUserId String
  changedByEmail  String
  oldPlan         String?
  newPlan         String?
  oldStatus       String?
  newStatus       String?
  notes           String?
  createdAt       DateTime @default(now())
  amount          Int?

  @@index([organizationId, createdAt])
}

model Staff {
  id             Int            @id @default(autoincrement())
  organizationId Int
  emri           String
  kodi           String?
  roli           String         @default("cashier")
  pinHash        String
  isActive       Boolean        @default(true)
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sales          Sale[]
  organization   Organization   @relation(fields: [organizationId], references: [id])
  sessions       StaffSession[]

  @@unique([organizationId, kodi])
  @@index([organizationId])
}

model StaffSession {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  staffId        Int
  organizationId Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@index([staffId])
  @@index([expiresAt])
}

/// Cross-instance duplicate-write protection.
///
/// One row per idempotent operation, owned by exactly one request. The unique
/// constraint on (organizationId, userId, route, key) is what makes the claim
/// atomic across Vercel instances: two concurrent duplicates both INSERT, the
/// database admits one and rejects the other with a unique violation.
///
/// Deliberately carries no foreign key to Organization. The row is short-lived
/// operational state, not tenant data: an FK would add a constraint check to
/// the hottest write path in the system and couple key expiry to the
/// organization lifecycle. Isolation is enforced instead by organizationId
/// being part of the unique tuple and of every query's WHERE clause.
/// BillingAuditLog already follows the same pattern.
///
/// Nothing sensitive is persisted. The request body is reduced to a
/// non-reversible fingerprint, response headers are never stored (they can
/// carry Set-Cookie), and responseBody holds only what was already sent to
/// this same client.
model IdempotencyRecord {
  id             Int       @id @default(autoincrement())
  organizationId Int
  /// Supabase user id or `staff:<id>`.
  userId         String
  /// Route identifier, e.g. `POST /api/sales`.
  route          String
  /// Client-supplied Idempotency-Key header.
  key            String
  /// Non-reversible hash of the request body; never the body itself.
  fingerprint    String
  /// `in_progress` while a request owns the claim, `completed` once settled.
  status         String    @default("in_progress")
  responseStatus Int?
  responseBody   Json?
  claimedAt      DateTime  @default(now())
  completedAt    DateTime?
  /// Claim lease while in progress, replay window once completed. A crashed
  /// instance therefore releases its claim automatically instead of pinning
  /// the key forever.
  expiresAt      DateTime

  @@unique([organizationId, userId, route, key])
  @@index([expiresAt])
}
