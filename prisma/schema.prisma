generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Organization {
  id            Int            @id @default(autoincrement())
  name          String
  telefoni      String?
  adresa        String?
  nipt          String?
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  products      Product[]
  sales         Sale[]
  suppliers     Supplier[]
  supplies      Supply[]
  userRoles     UserRole[]
  auditLogs     AuditLog[]
  notifications Notification[]
  subscription  Subscription?
  staff         Staff[]
}

model Supplier {
  id             Int          @id @default(autoincrement())
  emri           String
  telefoni       String?
  email          String?
  adresa         String?
  shenime        String?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  products       Product[]
  supplies       Supply[]
}

model Product {
  id             Int              @id @default(autoincrement())
  emri           String
  kategoria      String
  sasia          Float            @default(0)
  stokuMinimal   Float            @default(5)
  cmimiBlerjes   Float
  cmimiShitjes   Float
  njesia         String           @default("cope")
  isArchived     Boolean          @default(false)
  archivedAt     DateTime?
  furnitorId     Int?
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id])
  furnitor       Supplier?        @relation(fields: [furnitorId], references: [id])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  saleItems      SaleItem[]
  barcodes       ProductBarcode[]
  supplyItems    SupplyItem[]
}

model Supply {
  id             Int          @id @default(autoincrement())
  furnitorId     Int?
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  furnitor       Supplier?    @relation(fields: [furnitorId], references: [id])
  data           DateTime     @default(now())
  shenime        String?
  totali         Float        @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  items          SupplyItem[]
}

model SupplyItem {
  id            Int     @id @default(autoincrement())
  supplyId      Int
  supply        Supply  @relation(fields: [supplyId], references: [id], onDelete: Cascade)
  productId     Int
  product       Product @relation(fields: [productId], references: [id])
  emriProduktit String
  sasia         Float
  njesia        String
  cmimiBlerjes  Float
  totali        Float
}

model ProductBarcode {
  id        Int      @id @default(autoincrement())
  barcode   String   @unique
  productId Int
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
}

model Sale {
  id             Int          @id @default(autoincrement())
  totali         Float
  fitimi         Float
  shenime        String?
  paymentMethod  String       @default("cash")
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  staffId        Int?
  staffName      String?
  staff          Staff?       @relation(fields: [staffId], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())
  items          SaleItem[]
}

model SaleItem {
  id            Int     @id @default(autoincrement())
  saleId        Int
  productId     Int
  emriProduktit String
  sasia         Float
  cmimiBlerjes  Float
  cmimiShitjes  Float
  fitimi        Float
  sale          Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  product       Product @relation(fields: [productId], references: [id])
}

model UserRole {
  id             Int          @id @default(autoincrement())
  userId         String       @unique
  email          String
  roli           String       @default("staff")
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
}

model AuditLog {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String
  userEmail      String
  userRole       String
  action         String
  entityType     String
  entityId       String?
  description    String
  metadata       Json?
  createdAt      DateTime     @default(now())
}

model Notification {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  type           String
  title          String
  message        String
  severity       String       @default("medium")
  isRead         Boolean      @default(false)
  metadata       Json?
  createdAt      DateTime     @default(now())
}

model Subscription {
  id                 Int       @id @default(autoincrement())
  organizationId     Int       @unique
  organization       Organization @relation(fields: [organizationId], references: [id])
  plan               String    @default("trial")
  status             String    @default("trialing")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  nextPlan           String?
  cancelAtPeriodEnd  Boolean   @default(false)
  cancelledAt        DateTime?
  notes              String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
}

model BillingAuditLog {
  id              Int      @id @default(autoincrement())
  organizationId  Int
  changedByUserId String
  changedByEmail  String
  oldPlan         String?
  newPlan         String?
  oldStatus       String?
  newStatus       String?
  notes           String?
  amount          Int?
  createdAt       DateTime @default(now())
}

model Staff {
  id             Int            @id @default(autoincrement())
  organizationId Int
  organization   Organization   @relation(fields: [organizationId], references: [id])
  emri           String
  kodi           String?
  roli           String         @default("cashier")
  pinHash        String
  isActive       Boolean        @default(true)
  failedAttempts Int            @default(0)
  lockedUntil    DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  sessions       StaffSession[]
  sales          Sale[]

  @@unique([organizationId, kodi])
  @@index([organizationId])
}

model StaffSession {
  id             Int      @id @default(autoincrement())
  token          String   @unique
  staffId        Int
  staff          Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  organizationId Int
  expiresAt      DateTime
  createdAt      DateTime @default(now())

  @@index([staffId])
}
