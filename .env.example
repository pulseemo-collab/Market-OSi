# Database
DATABASE_URL=postgresql://...
DIRECT_URL=postgresql://...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Required for platform_owner to create/invite users via API
# Found in: Supabase Dashboard → Project Settings → API → service_role (secret)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# App URL (used in invite email redirect links)
NEXT_PUBLIC_APP_URL=https://your-app.com

# Sentry Error Monitoring (optional — app works without these)
# Get your DSN from https://sentry.io → Project → Settings → Client Keys
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=

# Sentry source map upload (optional — only needed for CI/CD)
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
